rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /scenarios/{scenarioId} {
      allow read: if isAuthed();
      allow write: if false;
    }

    match /sessions/{sessionId} {
      allow read: if isOwner(resource.data.uid);
      allow create, update: if false;
      allow delete: if false;

      match /reps/{repId} {
        allow read: if isOwner(get(/databases/$(database)/documents/sessions/$(sessionId)).data.uid);
        allow write: if false;
      }
    }

    match /progress_daily/{docId} {
      allow read: if isOwner(resource.data.uid);
      allow write: if false;
    }

    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /usage_weekly/{docId} {
      allow read, write: if false;
    }
  }
}
