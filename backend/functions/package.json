{
  "name": "clearify-functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/src/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
